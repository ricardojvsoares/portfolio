# Postgres connection string (Neon, Supabase, or any managed Postgres)
# Prefer the direct or session pooler URI. Include sslmode=require.
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Signed session cookies for the guestbook auth demo (min 32 characters)
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
